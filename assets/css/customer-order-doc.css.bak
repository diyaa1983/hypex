/**
 * طلب شراء عميل — شكل سند (شريط أوامر + بيانات السند + جدول + إضافة سطر + شريط مجاميع)
 * Scoped تحت .co-doc
 */

.co-doc.dashboard-ora.sales-ora12-screen {
  --co-blue: #1a5f9e;
  --co-blue-deep: #0f3f6a;
  --co-blue-soft: #e8f1f8;
  --co-ok: #1b7d3a;
  --co-ok-bg: #e8f5e9;
  --co-danger: #c62828;
  --co-danger-bg: #fdecea;
  --co-border: #c5d0db;
  --co-muted: #5a6a7a;
  background: #e9eef3;
}

/* شريط الأوامر */
.co-doc .co-doc-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.35rem;
  padding: 0.45rem 0.55rem;
  margin: 0 0 0.65rem;
  background: linear-gradient(180deg, #f7f9fb 0%, #e9eef3 100%);
  border: 1px solid var(--co-border);
  border-radius: 4px;
  box-shadow: 0 1px 0 #fff inset;
}

.co-doc .co-tb-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.1rem;
  min-width: 3.5rem;
  padding: 0.35rem 0.55rem 0.3rem;
  font-family: inherit;
  font-size: 0.72rem;
  font-weight: 700;
  color: #1e293b;
  text-decoration: none !important;
  background: linear-gradient(180deg, #ffffff 0%, #eef2f6 100%);
  border: 1px solid #b8c4d0;
  border-radius: 6px;
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.9) inset, 0 1px 2px rgba(15, 23, 42, 0.06);
  cursor: pointer;
  line-height: 1.15;
}

.co-doc .co-tb-btn:hover:not(:disabled) {
  background: linear-gradient(180deg, #fff 0%, #e2eaf2 100%);
  border-color: #8eabc4;
  color: #0f172a;
}

.co-doc .co-tb-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.co-doc .co-tb-ico {
  font-size: 1.05rem;
  font-weight: 800;
  line-height: 1;
  color: var(--co-ok);
}

.co-doc .co-tb-btn--ok .co-tb-ico {
  color: var(--co-ok);
}

.co-doc .co-tb-btn--ok {
  border-color: #9ccc9c;
  background: linear-gradient(180deg, #f4fff6 0%, #e2f3e6 100%);
}

.co-doc .co-tb-btn--danger {
  border-color: #e0a8a8;
  background: linear-gradient(180deg, #fff7f7 0%, #fdeaea 100%);
}

.co-doc .co-tb-btn--danger .co-tb-ico {
  color: var(--co-danger);
}

.co-doc .co-tb-btn--exit {
  margin-inline-start: auto;
  border-color: #e0a8a8;
  background: linear-gradient(180deg, #fff7f7 0%, #fce8e8 100%);
  color: var(--co-danger);
}

.co-doc .co-tb-btn--exit .co-tb-ico {
  color: var(--co-danger);
}

/* لوحة بيانات السند */
.co-doc .dashboard-ora-panel {
  border: 1px solid var(--co-border);
  border-radius: 4px;
  background: #fff;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  margin-bottom: 0.65rem;
  overflow: hidden;
}

.co-doc .dashboard-ora-panel__title {
  margin: 0;
  padding: 0.4rem 0.75rem;
  font-size: 0.82rem;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(180deg, #2a78bf 0%, var(--co-blue) 55%, var(--co-blue-deep) 100%);
  border-bottom: 1px solid var(--co-blue-deep);
}

.co-doc .dashboard-ora-panel__body {
  padding: 0.75rem 0.85rem;
  background: #fafbfc;
}

.co-doc .dashboard-ora-panel__body--flush {
  padding: 0.55rem 0.55rem 0.65rem;
}

.co-doc .sales-inv-meta-row {
  gap: 0.55rem 0.85rem;
}

.co-doc .sales-inv-meta-item label {
  font-size: 0.75rem;
  font-weight: 800;
  color: #334155;
}

.co-doc .sales-inv-meta-customer {
  flex: 1 1 16rem;
  min-width: 14rem;
}

.co-doc .input,
.co-doc select.input,
.co-doc textarea.input {
  background: #fff !important;
  border: 1px solid #b8c5d3 !important;
  border-radius: 4px !important;
  min-height: 2rem;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04);
}

.co-doc .input:focus,
.co-doc select.input:focus,
.co-doc textarea.input:focus {
  border-color: #3b82c4 !important;
  box-shadow: 0 0 0 2px rgba(26, 95, 158, 0.18) !important;
  outline: none !important;
}

.co-doc .sales-inv-no-input {
  font-weight: 800 !important;
  text-align: center;
}

/* الجدول */
.co-doc .sales-inv-table-wrap,
.co-doc #sales-inv-table-wrap {
  border: 1px solid var(--co-border) !important;
  border-radius: 3px !important;
  background: #fff;
  max-height: min(48vh, 520px);
  overflow: auto;
}

.co-doc .sales-inv-table thead th {
  background: #eef3f8 !important;
  color: #1e3a5f !important;
  font-weight: 800 !important;
  font-size: 0.72rem !important;
  border-bottom: 1px solid var(--co-border) !important;
  white-space: nowrap;
}

.co-doc .sales-inv-table tbody td {
  border-color: #edf1f5 !important;
  vertical-align: middle;
}

.co-doc .sales-inv-table tbody tr:hover td {
  background: #f5f9fc !important;
}

/* زر إضافة سطر */
.co-doc .co-doc-addline {
  display: flex;
  justify-content: flex-start;
  padding: 0.55rem 0.15rem 0.35rem;
}

.co-doc .co-add-line-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 2.35rem;
  padding: 0.45rem 1.15rem;
  font-family: inherit;
  font-size: 0.9rem;
  font-weight: 800;
  color: var(--co-blue);
  background: #fff;
  border: 1.5px solid #7eb0d8;
  border-radius: 6px;
  cursor: pointer;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
}

.co-doc .co-add-line-btn:hover {
  background: var(--co-blue-soft);
  border-color: var(--co-blue);
  color: var(--co-blue-deep);
}

/* تذييل: ملاحظات + مجاميع */
.co-doc .co-doc-footer {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 0.75rem;
  align-items: start;
  margin-top: 0.35rem;
  padding: 0 0.15rem;
}

@media (max-width: 900px) {
  .co-doc .co-doc-footer {
    grid-template-columns: 1fr;
  }
}

.co-doc .co-doc-totals {
  background: #fff;
  border: 1px solid var(--co-border);
  border-radius: 4px;
  padding: 0.45rem 0.65rem;
}

.co-doc .co-doc-totals .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  padding: 0.28rem 0;
  font-size: 0.82rem;
  border-bottom: 1px dashed #e2e8f0;
}

.co-doc .co-doc-totals .row:last-child {
  border-bottom: 0;
}

.co-doc .co-doc-totals .row > span:last-child {
  font-variant-numeric: tabular-nums;
  direction: ltr;
  font-weight: 700;
}

.co-doc .co-doc-totals .row.grand {
  margin-top: 0.2rem;
  padding-top: 0.45rem;
  border-top: 1px solid var(--co-border);
  font-weight: 800;
  font-size: 0.95rem;
}

.co-doc .co-doc-totals .row.grand span:last-child {
  color: var(--co-blue-deep);
  font-size: 1.1rem;
}

.co-doc .co-doc-totals .sales-inv-totals-disc {
  flex-wrap: wrap;
}

.co-doc .co-doc-totals .sales-inv-totals-disc #inv-invoice-discount {
  max-width: 6.5rem;
  margin-inline-start: auto;
  text-align: center;
}

.co-doc .co-doc-msg {
  margin: 0.45rem 0 0;
  min-height: 1.15rem;
  font-size: 0.82rem;
  font-weight: 700;
}

.co-doc .co-doc-msg.is-error {
  color: var(--co-danger);
}

.co-doc .co-doc-msg.is-ok {
  color: var(--co-ok);
}

/* شريط مجاميع أزرق أسفل النموذج */
.co-doc .co-doc-sumbar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  justify-content: flex-start;
  align-items: center;
  margin-top: 0.65rem;
  padding: 0.55rem 0.85rem;
  color: #fff;
  background: linear-gradient(180deg, #2a78bf 0%, var(--co-blue) 50%, var(--co-blue-deep) 100%);
  border-radius: 4px;
  border: 1px solid var(--co-blue-deep);
}

.co-doc .co-doc-sumbar__item {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  min-width: 5.5rem;
}

.co-doc .co-doc-sumbar__item span {
  font-size: 0.7rem;
  opacity: 0.9;
  font-weight: 600;
}

.co-doc .co-doc-sumbar__item strong {
  font-size: 0.95rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  direction: ltr;
  text-align: start;
}

.co-doc .co-doc-sumbar__item--grand {
  margin-inline-start: auto;
  padding-inline-start: 1rem;
  border-inline-start: 1px solid rgba(255, 255, 255, 0.28);
}

.co-doc .co-doc-sumbar__item--grand strong {
  font-size: 1.15rem;
}

/* عنوان الشاشة */
.co-doc .dashboard-ora-screen-title {
  margin-bottom: 0.35rem;
}

@media print {
  .co-doc .co-doc-toolbar,
  .co-doc .co-doc-addline,
  .co-doc .co-doc-sumbar {
    display: none !important;
  }
}


/* كشف رصيد العميل — مضغوط وأنيق (Node + PHP) */
.si-surface.co-ora-ar-panel {
  padding: 0.55rem 0.75rem 0.65rem;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  border: 1px solid #d8e0ea;
}

.si-surface.co-ora-ar-panel > .si-surface-head {
  margin-bottom: 0.4rem;
  padding-bottom: 0.3rem;
  border-bottom: 1px solid #e2e8f0;
  gap: 0.4rem;
}

.si-surface.co-ora-ar-panel > .si-surface-head h2 {
  font-size: 0.78rem !important;
  font-weight: 700;
  letter-spacing: 0;
  color: #334155;
}

.si-surface.co-ora-ar-panel > .si-surface-head .si-count {
  font-size: 0.68rem;
  font-weight: 600;
  color: #64748b;
  background: #fff;
  border: 1px solid #e2e8f0;
  padding: 0.1rem 0.4rem;
  border-radius: 999px;
  max-width: min(22rem, 55vw);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.co-ora-ar-panel .co-ora-ar-status,
.si-surface.co-ora-ar-panel .co-ora-ar-status,
.co-doc .co-ora-ar-status {
  margin: 0 0 0.35rem;
  font-size: 0.68rem;
  font-weight: 600;
  color: #64748b;
  line-height: 1.35;
}

.co-ora-ar-panel .co-ora-ar-status.is-error,
.co-doc .co-ora-ar-status.is-error {
  color: #b91c1c;
}

.co-ora-ar-panel .co-ora-ar-summary {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.co-ora-ar-panel .co-ora-ar-kpis,
.co-doc .co-ora-ar-kpis {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.3rem;
  margin: 0 0 0;
}

@media (max-width: 720px) {
  .co-ora-ar-panel .co-ora-ar-kpis,
  .co-doc .co-ora-ar-kpis {
    grid-template-columns: 1fr;
  }
}

.co-ora-ar-panel .co-ora-ar-kpi,
.co-doc .co-ora-ar-kpi {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-inline-start-width: 3px;
  border-radius: 4px;
  padding: 0.22rem 0.4rem 0.26rem;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.1rem 0.4rem;
  min-height: 0;
  box-shadow: none;
}

.co-ora-ar-panel .co-ora-ar-kpi span,
.co-doc .co-ora-ar-kpi span {
  font-size: 0.62rem;
  font-weight: 700;
  color: #64748b;
  line-height: 1.2;
}

.co-ora-ar-panel .co-ora-ar-kpi strong,
.co-doc .co-ora-ar-kpi strong {
  font-size: 0.78rem;
  font-weight: 700;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.co-ora-ar-panel .co-ora-ar-kpi--debit,
.co-doc .co-ora-ar-kpi--debit {
  border-inline-start-color: #ea580c;
  background: #fffbf7;
  border-color: #f0e0d4;
}

.co-ora-ar-panel .co-ora-ar-kpi--debit strong,
.co-doc .co-ora-ar-kpi--debit strong {
  color: #9a3412;
}

.co-ora-ar-panel .co-ora-ar-kpi--credit,
.co-doc .co-ora-ar-kpi--credit {
  border-inline-start-color: #16a34a;
  background: #f7fcf8;
  border-color: #d4e8da;
}

.co-ora-ar-panel .co-ora-ar-kpi--credit strong,
.co-doc .co-ora-ar-kpi--credit strong {
  color: #166534;
}

.co-ora-ar-panel .co-ora-ar-kpi--due,
.co-doc .co-ora-ar-kpi--due {
  border-inline-start-color: #2563eb;
  background: #f7faff;
  border-color: #d3e0f5;
}

.co-ora-ar-panel .co-ora-ar-kpi--due strong,
.co-doc .co-ora-ar-kpi--due strong {
  color: #1d4ed8;
  font-size: 0.82rem;
}

.co-ora-ar-panel .co-ora-ar-meta,
.co-doc .co-ora-ar-meta {
  margin: 0;
  font-size: 0.64rem;
  font-weight: 500;
  color: #94a3b8;
  line-height: 1.35;
}

.co-ora-ar-panel .co-ora-ar-chq-wrap {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 5px;
  overflow: hidden;
}

.co-ora-ar-panel .co-ora-ar-chq-title,
.co-doc .co-ora-ar-chq-title {
  margin: 0;
  padding: 0.25rem 0.45rem;
  font-size: 0.68rem;
  font-weight: 700;
  color: #475569;
  background: #f1f5f9;
  border-bottom: 1px solid #e2e8f0;
}

.co-ora-ar-panel .co-ora-ar-table-wrap,
.co-doc .co-ora-ar-table-wrap {
  border: 0;
  border-radius: 0;
  overflow: auto;
  max-height: 8.5rem;
  background: #fff;
  margin: 0;
}

.co-ora-ar-panel .co-ora-ar-table,
.co-doc .co-ora-ar-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.68rem;
}

.co-ora-ar-panel .co-ora-ar-table th,
.co-ora-ar-panel .co-ora-ar-table td,
.co-doc .co-ora-ar-table th,
.co-doc .co-ora-ar-table td {
  padding: 0.18rem 0.35rem;
  border-bottom: 1px solid #f1f5f9;
  text-align: right;
  line-height: 1.25;
  color: #334155;
}

.co-ora-ar-panel .co-ora-ar-table th,
.co-doc .co-ora-ar-table th {
  background: #fafbfc;
  font-weight: 700;
  font-size: 0.62rem;
  color: #64748b;
  position: sticky;
  top: 0;
  z-index: 1;
  border-bottom: 1px solid #e2e8f0;
}

.co-ora-ar-panel .co-ora-ar-table tbody tr:last-child td {
  border-bottom: 0;
}

.co-ora-ar-panel .co-ora-ar-table tbody tr:hover td {
  background: #f8fafc;
}

.co-ora-ar-panel .co-ora-ar-table .col-money,
.co-ora-ar-panel .co-ora-ar-table td[dir="ltr"],
.co-doc .co-ora-ar-table .col-money {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  font-size: 0.68rem;
}

.co-ora-ar-panel .co-ora-ar-table .muted {
  font-size: 0.64rem;
  color: #94a3b8;
  text-align: center;
}

.co-ora-ar-panel .co-ora-ar-chq-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.4rem;
  padding: 0.22rem 0.45rem;
  margin: 0;
  border-top: 1px solid #e2e8f0;
  background: #f8fafc;
  font-weight: 700;
  font-size: 0.66rem;
  color: #475569;
}

.co-ora-ar-panel .co-ora-ar-chq-total strong {
  font-variant-numeric: tabular-nums;
  font-size: 0.74rem;
  font-weight: 700;
  color: #1d4ed8;
}

.co-ora-ar-panel .co-ora-ar-actions,
.co-doc .co-ora-ar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  align-items: center;
  margin: 0.05rem 0 0;
}

.co-ora-ar-panel .co-ora-ar-actions .si-btn {
  min-height: 1.55rem;
  padding: 0.1rem 0.45rem;
  font-size: 0.66rem;
  font-weight: 600;
}

@media print {
  .co-ora-ar-panel .co-ora-ar-actions {
    display: none !important;
  }
}

/* نافذة ترحيل الكميات — ترحيل Oracle */
.co-batch-modal {
  position: fixed !important;
  inset: 0 !important;
  z-index: 10050;
  background: rgba(15, 23, 42, 0.5);
  display: flex !important;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  margin: 0;
  box-sizing: border-box;
}
.co-batch-modal[hidden] {
  display: none !important;
}
.co-batch-panel {
  background: #fff;
  border-radius: 10px;
  max-width: min(920px, 96vw);
  width: 100%;
  max-height: min(82vh, 720px);
  display: flex;
  flex-direction: column;
  box-shadow: 0 16px 48px rgba(15, 23, 42, 0.22);
  border: 1px solid rgba(15, 23, 42, 0.08);
  overflow: hidden;
  margin: auto;
}
.co-batch-head {
  padding: 0.55rem 0.85rem 0.45rem;
  border-bottom: 1px solid #e2e8f0;
  background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
}
.co-batch-head h3 {
  margin: 0;
  font-size: 0.95rem;
  color: #0f172a;
}
#co-batch-sub,
.co-batch-head .muted {
  display: none !important;
}
.co-batch-body-wrap {
  padding: 0.5rem 0.7rem 0.65rem;
  overflow: auto;
  flex: 1;
}
.co-batch-table {
  width: 100%;
  table-layout: fixed;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 0.74rem;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
}
.co-batch-table thead th {
  background: #0f172a;
  color: #f1f5f9;
  font-weight: 700;
  font-size: 0.66rem;
  letter-spacing: 0.01em;
  padding: 0.28rem 0.3rem;
  text-align: right;
  border-bottom: 1px solid #0b1220;
  white-space: nowrap;
}
.co-batch-table thead th:nth-child(1) { width: 1.7rem; text-align: center; }
.co-batch-table--alloc thead th:nth-child(2) { width: 30%; }
.co-batch-table--alloc thead th:nth-child(3) { width: 9%; }
.co-batch-table--alloc thead th:nth-child(4),
.co-batch-table--alloc thead th:nth-child(5),
.co-batch-table--alloc thead th:nth-child(6),
.co-batch-table--alloc thead th:nth-child(8) {
  width: 4.6rem;
  text-align: center;
}
.co-batch-table--alloc thead th:nth-child(7) { width: 22%; }

.co-batch-table tbody td {
  padding: 0.18rem 0.28rem;
  border-bottom: 1px solid #e2e8f0;
  border-inline-end: 1px solid #eef2f7;
  text-align: right;
  vertical-align: middle;
  background: #fff;
  height: 2.05rem;
}
.co-batch-table tbody td:last-child {
  border-inline-end: 0;
}
.co-batch-table tbody tr:last-child td {
  border-bottom: 0;
}
.co-batch-table tbody tr:nth-child(even):not(.co-batch-row--nostock):not(.co-batch-row--invalid):not(.co-batch-row--cont) td {
  background: #f8fafc;
}
.co-batch-table tbody tr.co-batch-row--cont td {
  background: #f1f5f9;
}
.co-batch-table tbody tr.co-batch-row--cont .co-batch-col-item {
  opacity: 0.92;
}
.co-batch-table .co-batch-col-idx {
  text-align: center;
  color: #64748b;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.co-batch-table .co-batch-col-need,
.co-batch-table .co-batch-col-qty,
.co-batch-table .co-batch-col-bonus,
.co-batch-table .co-batch-col-take,
.co-batch-table .co-batch-col-bal {
  text-align: center;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  direction: ltr;
}
.co-batch-table .co-batch-col-qty,
.co-batch-table .co-batch-col-bonus,
.co-batch-table .co-batch-col-cat {
  vertical-align: middle;
  background: #f8fafc;
}
.co-batch-table .co-batch-col-batch {
  direction: ltr;
  unicode-bidi: embed;
  font-weight: 600;
  color: #0f172a;
}
.co-batch-table .co-batch-col-cat {
  min-width: 0;
}
.co-batch-table .co-cat-fixed {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
}
.co-batch-table .co-cat-fixed-label {
  display: block;
  width: 100%;
  min-width: 0;
  padding: 0.15rem 0.25rem;
  border-radius: 5px;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  color: #334155;
  font-size: 0.7rem;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  cursor: default;
  user-select: none;
}
.co-batch-table select.co-cat-select {
  display: none;
}
.co-batch-table .co-batch-col-item {
  overflow: hidden;
  max-width: 0;
}
.co-batch-table .co-batch-item-line {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 0.3rem;
  min-width: 0;
  line-height: 1.2;
  white-space: nowrap;
}
.co-batch-table .co-batch-item-code {
  flex: 0 0 auto;
  font-weight: 800;
  color: #0f172a;
  direction: ltr;
  unicode-bidi: embed;
  white-space: nowrap;
  font-size: 0.74rem;
}
.co-batch-table .co-batch-item-name {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
  color: #475569;
  font-size: 0.72rem;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.co-batch-table .co-batch-item-cont {
  font-size: 0.72rem;
  color: #64748b;
}
.co-batch-table select,
.co-batch-table .si-field.co-batch-select {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 1.7rem;
  min-height: 1.7rem;
  border: 1px solid #cbd5e1;
  border-radius: 5px;
  padding: 0.1rem 0.3rem;
  background: #fff;
  font: inherit;
  font-size: 0.7rem;
  box-sizing: border-box;
}
.co-batch-table select:focus {
  outline: 2px solid rgba(14, 165, 233, 0.45);
  outline-offset: 1px;
  border-color: #0ea5e9;
}
.co-batch-need-input,
.co-batch-qty-input,
.co-batch-bonus-input,
.co-batch-take-input {
  display: block;
  width: 100%;
  max-width: 4.4rem;
  margin-inline: auto;
  height: 1.7rem;
  min-height: 1.7rem;
  border: 1px solid #cbd5e1;
  border-radius: 5px;
  padding: 0.1rem 0.25rem;
  text-align: center;
  direction: ltr;
  font: inherit;
  font-size: 0.74rem;
  font-weight: 700;
  background: #fff;
  box-sizing: border-box;
}
.co-batch-need-input:focus,
.co-batch-qty-input:focus,
.co-batch-bonus-input:focus,
.co-batch-take-input:focus {
  outline: 2px solid rgba(14, 165, 233, 0.45);
  outline-offset: 1px;
  border-color: #0ea5e9;
}
.co-batch-qty-input,
.co-batch-bonus-input,
.co-batch-need-input {
  border-color: #94a3b8;
  background: #fff;
}
.co-batch-take-input.co-batch-take--bad {
  background: #fef2f2;
  border-color: #f87171;
  color: #b91c1c;
}

.co-batch-table tbody tr.co-batch-row--nostock td {
  background: #fff7ed !important;
  border-bottom-color: #fed7aa;
  height: auto;
}
.co-batch-table tbody tr.co-batch-row--invalid td {
  background: #fee2e2 !important;
  border-bottom-color: #f87171;
  color: #7f1d1d;
}
.co-batch-table tbody tr.co-batch-row--nostock select {
  border-color: #fdba74;
  background: #fffbeb;
  color: #9a3412;
}
.co-batch-warn {
  color: #9a3412;
  font-size: 0.78rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.35;
  padding: 0.15rem 0;
}
.co-batch-foot {
  padding: 0.55rem 0.85rem;
  border-top: 1px solid #e2e8f0;
  display: flex;
  gap: 0.45rem;
  justify-content: flex-end;
  align-items: center;
  background: #f8fafc;
}
.co-batch-status {
  flex: 1;
  text-align: right;
  font-size: 0.75rem;
  color: #64748b;
  padding-inline-end: 0.4rem;
  align-self: center;
}
.co-batch-status.is-error {
  color: #b91c1c;
  font-weight: 700;
}
.co-batch-status.is-ok {
  color: #15803d;
  font-weight: 700;
}
#co-batch-confirm:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.co-batch-foot {
  padding: 0.75rem 1.15rem;
  border-top: 1px solid #e2e8f0;
  display: flex;
  gap: 0.55rem;
  justify-content: flex-end;
  align-items: center;
  background: #f8fafc;
}

/* اختصارات بجانب عنوان الطلب — التنسيق الأساسي في sales-2027.css */
.si-keys-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.35rem;
  padding: 0;
  margin: 0;
}
/* بدون حركات/اهتزاز عند الاختيار أو الحفظ */
.si-stage.si-stage--toolbar-first,
.si-stage.si-stage--toolbar-first * {
  animation: none !important;
  transition: none !important;
  scroll-behavior: auto !important;
}
.si-stage.si-stage--toolbar-first .si-tb:hover:not(:disabled),
.si-stage.si-stage--toolbar-first .si-tb:active:not(:disabled) {
  transform: none !important;
}
.si-stage.si-stage--toolbar-first.is-nav-loading,
.si-stage.si-stage--toolbar-first.is-nav-flash {
  opacity: 1 !important;
  filter: none !important;
}

/* نصوص شاشة الطلب سوداء — رقم الطلب يبقى بألوانه (أحمر معتمد / أخضر محفوظ) */
.si-stage.si-stage--toolbar-first,
.si-stage.si-stage--toolbar-first .si-doc-screen-title,
.si-stage.si-stage--toolbar-first .si-surface-head h2,
.si-stage.si-stage--toolbar-first .si-surface-head .si-count,
.si-stage.si-stage--toolbar-first .si-f-head,
.si-stage.si-stage--toolbar-first .si-key-desc,
.si-stage.si-stage--toolbar-first .si-key-hint,
.si-stage.si-stage--toolbar-first .si-field,
.si-stage.si-stage--toolbar-first select.si-field,
.si-stage.si-stage--toolbar-first textarea,
.si-stage.si-stage--toolbar-first .si-lines th,
.si-stage.si-stage--toolbar-first .si-lines td,
.si-stage.si-stage--toolbar-first .si-lines input,
.si-stage.si-stage--toolbar-first .si-lines select,
.si-stage.si-stage--toolbar-first .si-notes,
.si-stage.si-stage--toolbar-first .si-notes label,
.si-stage.si-stage--toolbar-first .si-totals label,
.si-stage.si-stage--toolbar-first .si-tot-row,
.si-stage.si-stage--toolbar-first .si-tot-row span,
.si-stage.si-stage--toolbar-first .si-tot-row strong,
.si-stage.si-stage--toolbar-first .si-tot-grand,
.si-stage.si-stage--toolbar-first .si-tot-grand span,
.si-stage.si-stage--toolbar-first .si-tot-grand strong,
.si-stage.si-stage--toolbar-first .si-pill,
.si-stage.si-stage--toolbar-first .muted,
.si-stage.si-stage--toolbar-first .si-price-mode,
.si-stage.si-stage--toolbar-first .si-docno-btn {
  color: #000 !important;
}

.si-stage.si-stage--toolbar-first .si-keys-bar .si-field-key {
  color: #000 !important;
}

/* رقم الطلب فقط — كما هو */
.si-stage.si-stage--toolbar-first #co_no.is-approved,
.si-stage.si-stage--toolbar-first .si-docno-input.is-approved,
.si-stage.si-stage--toolbar-first #inv_no.is-approved {
  color: #b91c1c !important;
}
.si-stage.si-stage--toolbar-first #co_no.is-saved,
.si-stage.si-stage--toolbar-first .si-docno-input.is-saved,
.si-stage.si-stage--toolbar-first #inv_no.is-saved {
  color: #047857 !important;
}
