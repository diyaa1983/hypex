<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# جذر السيرفر → Hypex
RewriteRule ^$ /hypex/ [R=302,L]

# مسارات Hypex بدون بادئة /hypex → التطبيق
RewriteCond %{REQUEST_URI} ^/(n|sales|customers|purchases|sales-reps|accounting|inventory|hr|system|suppliers|mobile|main|hub|menu|app|embed|login|logout)(/|$)
RewriteRule ^ /hypex%{REQUEST_URI} [R=302,L,QSA]
</IfModule>

ErrorDocument 404 /hypex-root-redirect.php
