# منفذ داخلي لـ Node (Apache يوجّه /hypex إليه)
PORT=3000

# نفس الرابط القديم تحت XAMPP
APP_BASE_PATH=/hypex

# MySQL — نفس قاعدة Hypex
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hypex
DB_USER=root
DB_PASS=

# شاشات PHP المتبقية (iframe) — نفس مجلد /hypex
PHP_BASE_URL=http://127.0.0.1/hypex

# سر الجلسة — غيّره في الإنتاج
SESSION_SECRET=hypex-node-dev-change-me
